{
  "$schema": "https://schema.tauri.app/config/3",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 600,
        "title": "universal-player-3",
        "width": 800,
        "label": "main",
        "url": "tauri://localhost:7644/app-x/"
      }
    ]
  },
  "build": {
    "devUrl": "http://localhost:7644",
    "frontendDist": "../../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["appimage"]
  },
  "identifier": "cat.lab9.player3",
  "plugins": {
    "typegen": {
      "excludePatterns": null,
      "force": false,
      "includePatterns": null,
      "includePrivate": false,
      "outputPath": "./packages/commands/lib",
      "projectPath": ".",
      "typeMappings": null,
      "validationLibrary": "zod",
      "verbose": false,
      "visualizeDeps": false
    }
  },
  "productName": "universal-player-3",
  "version": "0.1.0"
}
